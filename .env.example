# Locally (npm scripts), shared values live in .env and each process adds its own file on top
# (later files win):  node --env-file=.env --env-file=.env.worker-a ...
# On the Docker host (README "Deploy"), each container gets only its .env.<role>, so each one holds
# that process's full env, and .env holds just RELAY_HOST (for compose.yaml).
# Every .env* file except this one is gitignored.

# --- .env (shared) ---
ARKIV_HTTP=https://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_WS=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
# comma-separated worker addresses; workers, relay + web build-time.
# Each worker's own address must be listed, or its receipts won't count in the dedupe check.
# List worker A (delay 0) first: the web app names them A, B… in this order.
TRUSTED_WORKERS=

# --- .env.worker-a / .env.worker-b / .env.relay (one per process) ---
# X-API-KEY header; never shipped to the browser
ARKIV_ACCESS_KEY=
# worker only
WORKER_PRIVATE_KEY=
# 0 for worker A, 15 for worker B
WORKER_DELAY_BLOCKS=0
# relay only
SPONSOR_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
# optional; default state/relay.db. On the host, a path on a mounted volume (Q-7)
RELAY_DB_PATH=
# optional; default 8080. Hosts like Railway set it for you
PORT=
# optional; turns on the docs assistant (POST /ask), free models via openrouter.ai/keys. Never shipped to the browser
OPENROUTER_API_KEY=
# optional; comma-separated OpenRouter model ids, first choice first. Default: relay/ask.ts FREE_MODELS
ASK_MODELS=
# optional; default 45. Docs questions per UTC day, across everyone (free models allow 50/day)
ASK_DAILY_CAP=

# --- seed only (npm run seed; put them in .env) ---
DEMO_PUBLISHER_PRIVATE_KEY=
DEMO_SUBSCRIBER_PRIVATE_KEY=
# optional; prefix the printed #/s/<key> links with the deployed web app, and build t.me links.
# The relay also reads WEB_URL (https): the bot's "Open Prometheus" menu button and alert Status links.
WEB_URL=
VITE_BOT_NAME=
# --- web build only ---
# optional; the relay's public https URL, so the Telegram Mini App can offer free GLM (/sponsor)
RELAY_PUBLIC_URL=
